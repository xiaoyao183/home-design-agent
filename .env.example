# 复制为 .env 后填入（切勿提交 .env 到公开仓库）

# ========== 核心配置：图像生成 + 语义理解 ==========

# 1. 图像生成后端
# 可选值: replicate | seedream | openai
# 不填时自动检测：优先 openai > seedream > replicate
IMAGE_PROVIDER=openai

# 2. OpenAI API Key (用于图像生成 + 视觉理解)
# apimart.ai 获取地址: https://docs.apimart.ai/cn/api-reference/images/gpt-image-2/generation
OPENAI_API_KEY=sk-q1tmljedMEpPYpoxXKIEFdWY1PHHCANxUFbeY91IbnVR1Viu

# OpenAI 图像模型（默认 gpt-image-2）
OPENAI_IMAGE_MODEL=gpt-image-2

# OpenAI 生成图片比例或像素（apimart 推荐比例 + resolution，如 3:4 竖版）
# 比例示例: 3:4, 9:16, 1:1 ；像素示例: 1024x1366
OPENAI_IMAGE_SIZE=3:4
# 仅当 OPENAI_IMAGE_SIZE 为比例（含 : 不含 x）时生效
OPENAI_IMAGE_RESOLUTION=1k
# 轮询任务（可选，默认首次等 12s、每 4s 查一次、最多 45 次）
# OPENAI_POLL_INITIAL_DELAY_MS=12000
# OPENAI_POLL_INTERVAL_MS=4000
# OPENAI_POLL_MAX_RETRIES=45

# OpenAI API 基础 URL（apimart.ai 使用此地址）
OPENAI_BASE_URL=https://api.apimart.ai/v1

# OpenAI LoRA 配置（可选，用于风格控制）
# 在 apimart.ai 平台上传 LoRA 后指定名称
# DEFAULT_OPENAI_LORA=my-style-lora
# OPENAI_LORA_SCALE=0.8

# 3. Replicate API Token (备选)
# 用于调用 ControlNet 模型进行精准的图像生成
# 获取地址: https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=

# 4. DeepSeek API Key (用于从效果图自动分析房间类型和风格关键词)
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ========== 备用配置 ==========

# 火山方舟 Seedream
# SEEDREAM_API_KEY=
# SEEDREAM_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
# SEEDREAM_MODEL=doubao-seedream-5-0-260128
