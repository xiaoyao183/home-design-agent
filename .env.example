# 复制为 .env 后填入（切勿提交 .env 到公开仓库）
#
# ========== 图像生成（二选一，并设置 IMAGE_PROVIDER）==========
# replicate = 走 Replicate 的 Flux Kontext
# seedream  = 走火山方舟 Seedream（需火山引擎「方舟」API Key，与 Replicate 不是同一个东西）
IMAGE_PROVIDER=replicate

# Replicate 专用：仅当 IMAGE_PROVIDER=replicate
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Seedream 专用：仅当 IMAGE_PROVIDER=seedream
# 火山引擎方舟控制台创建 API Key；也可把 Key 只填在上一行 REPLICATE_API_TOKEN 里但务必设 IMAGE_PROVIDER=seedream
SEEDREAM_API_KEY=
# 默认已填火山北京方舟文生图/图生图接口，若控制台给你的是其他区域/版本请改
# SEEDREAM_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
# SEEDREAM_MODEL=doubao-seedream-4-0-250828
# SEEDREAM_SIZE=2K

# ========== 可选：多模态读「效果图」并写描述（OpenAI 或 DeepSeek）==========
# 二选一或都填时以 DEEPSEEK_API_KEY 优先于 OPENAI_API_KEY
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# 使用 DeepSeek 时建议显式设置（把 Key 放在 OPENAI_API_KEY 里时尤其要加这一行）
# LLM_PROVIDER=deepseek
# 多模态模型名（以各平台文档为准；若报「不支持 image」可只填用户文字说明，或换支持视图的模型）
# LLM_VISION_MODEL=deepseek-v4-flash

# 使用 OpenAI 官方或其它兼容服务时可改基址/模型
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_VISION_MODEL=gpt-4o-mini
