# 复制为 .env 后填入（切勿提交 .env 到公开仓库）

# ========== 核心配置：图像生成 + 语义理解 ========== 

# 1. 图像生成后端（当前方案固定为 replicate）
IMAGE_PROVIDER=replicate

# 2. Replicate API Token (必需)
# 用于调用 ControlNet 模型进行精准的图像生成
# 获取地址: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# 3. DeepSeek API Key (强烈推荐)
# 用于从效果图自动分析房间类型和风格关键词，大幅提升生成效果
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ========== 备用或已废弃的配置 ========== 

# 如果需要切换回火山方舟，请将 IMAGE_PROVIDER 改为 seedream，并填写下面的 KEY
# SEEDREAM_API_KEY=

# LLM_PROVIDER 用于在多个大语言模型服务商之间切换，当前方案固定使用 deepseek
# LLM_PROVIDER=deepseek
